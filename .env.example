# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=wagering-processor
HTTP_PORT=3000
HTTP_HOST=0.0.0.0
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=wagering
DATABASE_PASSWORD=wagering
DATABASE_NAME=wagering
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_LOCK_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# AWS SQS (LocalStack)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT=http://localhost:4566

SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_RECEIVE_COUNT=5
SQS_BATCH_SIZE=10
SQS_POLL_ENABLED=true

# ---------------------------------------------------------------------------
# Workers
# ---------------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BASE_BACKOFF_MS=1000
OUTBOX_MAX_BACKOFF_MS=60000

PENDING_REFERENCE_POLL_INTERVAL_MS=2000
PENDING_REFERENCE_MAX_ATTEMPTS=8
PENDING_REFERENCE_BASE_BACKOFF_MS=2000
PENDING_REFERENCE_MAX_BACKOFF_MS=300000

# default currency for the whole challenge
DEFAULT_CURRENCY=BRL
