{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed wagering processor for Jungle Gaming technical challenge",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "migration:up": "bun run src/infrastructure/persistence/mikro-orm/cli.ts up",
    "migration:down": "bun run src/infrastructure/persistence/mikro-orm/cli.ts down",
    "migration:create": "bun run src/infrastructure/persistence/mikro-orm/cli.ts create",
    "migration:fresh": "bun run src/infrastructure/persistence/mikro-orm/cli.ts fresh",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun run test/load/run.ts",
    "infra:up": "docker compose up -d postgres localstack",
    "infra:down": "docker compose down -v",
    "infra:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.699.0",
    "@mikro-orm/core": "^6.4.3",
    "@mikro-orm/migrations": "^6.4.3",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.3",
    "@mikro-orm/reflection": "^6.4.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "ajv": "^8.17.1",
    "decimal.js": "^10.4.3",
    "nestjs-pino": "^4.3.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "bun-types": "^1.4.3",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
